# CS Agent frontend build variables.
# Copy to frontend/.env for local builds and the Vite dev server. Vite reads
# this folder's .env, not the repo root .env. On a host like Render, set these
# on the web service instead: they are read when ./build.sh runs and inlined
# into the built app, so changing one needs a rebuild.
# Placeholder values only; never commit real values.

# [required] Clerk publishable key for the React app (pk_test_... or pk_live_...)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
# [optional] API base URL for the React app. Default same origin
VITE_API_URL=
# [optional] Company name in the app's "by ..." tagline. Default "Your Company"
VITE_COMPANY_NAME=Your Company
