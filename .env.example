# CS Agent environment variables.
# Copy to .env and fill in. Placeholder values only; never commit real values.
# [required] = the app will not work (or fails closed) without it.
# [optional] = has a default or only enables a feature.

# ── Deployment settings (product/settings.py) ────────────────────────────────
# [optional] Public origin of this deployment; used for links, runtime OAuth callback defaults, emails, digests. Default http://localhost:8000
PUBLIC_BASE_URL=https://your-app.example.com
# [optional] Claude model id for every LLM call. Default claude-sonnet-4-6
ANTHROPIC_MODEL=claude-sonnet-4-6
# [optional] true enables the scripted /demo and all demo-account paths. Default off
DEMO_MODE=false
# [optional] true enables the Stripe subscription gate, checkout, portal, webhook and trial jobs. Default off
BILLING_ENABLED=false

# ── Operator identity (product/settings.py) ──────────────────────────────────
# [optional] Contact address shown on status/security/support pages and used for operator alerts. Default support@example.com
SUPPORT_EMAIL=support@example.com
# [optional] Default From address for system emails (SYSTEM_EMAIL_ADDRESS overrides). Default noreply@example.com
FROM_EMAIL=noreply@example.com
# [optional] Company name in page titles, the security pages and trial emails. Default "Your Company"
COMPANY_NAME=Your Company
# [optional] Legal entity name in security page metadata. Default COMPANY_NAME
COMPANY_LEGAL_NAME=Your Company
# [optional] Company website domain named on the security and accessibility pages. Default example.com
COMPANY_DOMAIN=example.com
# [optional] Signature name on trial emails. Default "The team"
SENDER_NAME=The team
# [optional] Title before COMPANY_NAME in the day-1 trial email signature. Default empty
SENDER_TITLE=
# [optional] Landing page "Join the waitlist" link. Default mailto:SUPPORT_EMAIL
WAITLIST_FORM_URL=https://forms.example.com/your-form

# ── Core ─────────────────────────────────────────────────────────────────────
# [required] Anthropic API key for all LLM calls
ANTHROPIC_API_KEY=your-anthropic-api-key
# [required] Postgres connection string
DATABASE_URL=postgresql://user:password@localhost:5432/csagent
# [required] Fernet key (44-char URL-safe base64) encrypting OAuth tokens; app refuses to start without it
TOKEN_ENCRYPTION_KEY=your-fernet-key
# [optional] Redis for the arq background worker; falls back to in-process tasks
REDIS_URL=redis://localhost:6379/0
# [optional] Port uvicorn binds to on the host (set by Render)
PORT=8000

# ── Auth (Clerk) ─────────────────────────────────────────────────────────────
# [required] Clerk backend API key
CLERK_SECRET_KEY=your-clerk-secret-key
# [required] Clerk frontend API host for JWKS; if unset every authenticated request returns 401
CLERK_FRONTEND_API=clerk.your-app.example.com

# ── Security / admin ─────────────────────────────────────────────────────────
# [optional] Shared secret for /admin/* (X-Admin-Key header); admin routes refuse without it
ADMIN_SECRET=your-admin-secret
# [optional] Comma-separated CORS allowlist; '*' is rejected. Default PUBLIC_BASE_URL + local dev ports
CORS_ALLOWED_ORIGINS=https://your-app.example.com

# ── Google (Gmail, Calendar, Drive) ──────────────────────────────────────────
# [required] Google OAuth client id
GOOGLE_CLIENT_ID=your-google-client-id
# [required] Google OAuth client secret
GOOGLE_CLIENT_SECRET=your-google-client-secret
# [optional] Override the Google OAuth callback. Default PUBLIC_BASE_URL/auth/google/callback
GOOGLE_REDIRECT_URI=https://your-app.example.com/auth/google/callback

# ── HubSpot ──────────────────────────────────────────────────────────────────
# [optional] HubSpot OAuth client id (required to connect HubSpot)
HUBSPOT_CLIENT_ID=your-hubspot-client-id
# [optional] HubSpot OAuth client secret
HUBSPOT_CLIENT_SECRET=your-hubspot-client-secret
# [optional] Override the HubSpot OAuth callback. Default PUBLIC_BASE_URL/auth/hubspot/callback
HUBSPOT_REDIRECT_URI=https://your-app.example.com/auth/hubspot/callback
# [optional] true serves mock HubSpot data (development only)
HUBSPOT_USE_MOCK=false

# ── Gainsight ────────────────────────────────────────────────────────────────
# [optional] Gainsight OAuth client id (required to connect Gainsight)
GAINSIGHT_CLIENT_ID=your-gainsight-client-id
# [optional] Gainsight OAuth client secret
GAINSIGHT_CLIENT_SECRET=your-gainsight-client-secret
# [optional] Gainsight tenant domain
GAINSIGHT_DOMAIN=your-tenant.gainsightcloud.com
# [optional] Override the Gainsight OAuth callback. Default PUBLIC_BASE_URL/auth/gainsight/callback
GAINSIGHT_REDIRECT_URI=https://your-app.example.com/auth/gainsight/callback
# [optional] true serves mock Gainsight data (development only)
GAINSIGHT_USE_MOCK=false

# ── Slack ────────────────────────────────────────────────────────────────────
# [optional] Slack OAuth client id (required to connect Slack)
SLACK_CLIENT_ID=your-slack-client-id
# [optional] Slack OAuth client secret
SLACK_CLIENT_SECRET=your-slack-client-secret
# [optional] Override the Slack OAuth callback. Default PUBLIC_BASE_URL/auth/slack/callback
SLACK_REDIRECT_URI=https://your-app.example.com/auth/slack/callback
# [optional] Override the Slack user scopes requested at connect
SLACK_USER_SCOPES=
# [optional] true enables Slack signal extraction. Default false
SLACK_SIGNALS_ENABLED=false
# [optional] Incoming-webhook URL for internal Slack notifications
SLACK_WEBHOOK_URL=

# ── Zoom ─────────────────────────────────────────────────────────────────────
# [optional] Zoom OAuth client id (required to connect Zoom)
ZOOM_CLIENT_ID=your-zoom-client-id
# [optional] Zoom OAuth client secret
ZOOM_CLIENT_SECRET=your-zoom-client-secret
# [optional] Override the Zoom OAuth callback. Default PUBLIC_BASE_URL/auth/zoom/callback
ZOOM_REDIRECT_URI=https://your-app.example.com/auth/zoom/callback
# [optional] Override the Zoom scopes requested at connect
ZOOM_SCOPES=
# [optional] Override the Zoom MCP server URL
ZOOM_MCP_URL=
# [optional] Zoom webhook secret token; Zoom webhooks are rejected without it
ZOOM_WEBHOOK_SECRET_TOKEN=your-zoom-webhook-secret
# [optional] true enables Zoom signal extraction. Default false
ZOOM_SIGNALS_ENABLED=false

# ── Billing (only read when BILLING_ENABLED=true) ────────────────────────────
# [optional] Stripe secret key
STRIPE_SECRET_KEY=your-stripe-secret-key
# [optional] Stripe price id for the subscription
STRIPE_PRICE_ID=your-stripe-price-id
# [optional] Stripe webhook signing secret; webhooks are rejected without it
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# ── Email ────────────────────────────────────────────────────────────────────
# [optional] SMTP username for system emails (digest notifications, alerts)
SYSTEM_EMAIL_SMTP_USER=you@example.com
# [optional] SMTP password / app password for system emails
SYSTEM_EMAIL_PASSWORD=your-smtp-app-password
# [optional] From address for system emails. Default is the SMTP sender in code
SYSTEM_EMAIL_ADDRESS=you@example.com
# [optional] Receives pipeline failure alerts and feedback. Default SUPPORT_EMAIL
FOUNDER_EMAIL=you@example.com

# ── Feature flags ────────────────────────────────────────────────────────────
# [optional] true routes the digest through the new generator. Default false
DIGEST_GENERATOR_ENABLED=false
# [optional] true enables tool-use in /chat. Default false
CHAT_TOOL_USE_ENABLED=false
# [optional] Per-tool timeout in seconds for chat tools. Default 30
CHAT_TOOL_TIMEOUT_S=30

# ── Demo (only read when DEMO_MODE=true) ─────────────────────────────────────
# [required with DEMO_MODE] Password for the /demo page; no default, /demo refuses access without it
DEMO_PASSWORD=your-demo-password
# [optional] Email of the demo account (exact match, case-insensitive). Default demo@example.com
DEMO_EMAIL=demo@example.com
# [optional] csm_id of the demo identity. Default demo_user
DEMO_CSM_ID=demo_user
# [optional] API key mapping X-CSM-API-Key to the demo identity; no default
CSM_API_KEY_SARAH_C=
# [optional] Legacy /login credentials, one set per csm_id: CSM_<ID>_PASSWORD, CSM_<ID>_NAME, CSM_<ID>_EMAIL
CSM_SARAH_C_PASSWORD=
CSM_SARAH_C_NAME=
CSM_SARAH_C_EMAIL=

# ── org_config.json credential references ────────────────────────────────────
# [optional] org_config.json may reference any variable as {"env": "VAR_NAME"}; define those here too.

# ── Frontend build ──────────────────────────────────────────────────────────
# The VITE_* variables (VITE_CLERK_PUBLISHABLE_KEY is required) belong in
# frontend/.env, not here: Vite reads that folder's .env. See
# frontend/.env.example. On a hosted deploy, set them on the web service.
